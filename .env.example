# Variables de entorno del proyecto. Este archivo NO lleva valores reales.
#
# Cómo usarlo:
#   1. Copia este archivo como .env.local (está en .gitignore; nunca se sube).
#   2. Llena los valores del entorno que vas a usar (ver abajo).
#   3. Nunca pongas valores reales en este archivo ni en el código.
#
# Entornos:
#   - Local: con Docker corriendo, ejecuta `npm run db:start` y luego
#     `npm run db:status`. Ahí aparecen la URL de la API, la clave
#     "Publishable" y la clave "Secret" del entorno local.
#   - Pruebas (staging): proyecto propio en Supabase. Los valores están en
#     el panel de Supabase, Project Settings > API Keys.
#   - Producción: solo se configura en el proveedor de hosting, nunca aquí
#     (ver la skill pre-deploy-checklist).

# --- Supabase -------------------------------------------------------------

# URL de la API de Supabase. Local: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Clave publicable (empieza por sb_publishable_). Llega al navegador; está
# protegida por RLS. La app se niega a arrancar si aquí hay una clave secreta.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave secreta (empieza por sb_secret_). SOLO SERVIDOR: se salta RLS.
# Nunca le pongas el prefijo NEXT_PUBLIC_. La usan workers y webhooks.
SUPABASE_SECRET_KEY=

# --- Cola de acciones (D-034) ----------------------------------------------

# Secreto compartido entre pg_cron y el endpoint /api/workers/actions.
# Mínimo 32 caracteres aleatorios; genera uno con: openssl rand -hex 32
# El mismo valor se guarda en Supabase Vault con el nombre
# "actions_worker_secret", junto a "actions_worker_url" (la URL del endpoint).
WORKER_SECRET=

# --- Wompi (D-040) ---------------------------------------------------------
# Panel de comercios de Wompi > Desarrolladores. Usa SOLO llaves del mismo
# ambiente: la app se niega a arrancar si se mezclan pruebas y producción.

# "sandbox" (pruebas) o "production".
WOMPI_ENV=

# Llave pública (pub_test_... en sandbox).
WOMPI_PUBLIC_KEY=

# Llave privada (prv_test_... en sandbox). SOLO SERVIDOR: consulta transacciones.
WOMPI_PRIVATE_KEY=

# Secreto de eventos (test_events_...). SOLO SERVIDOR: verifica los webhooks.
WOMPI_EVENTS_SECRET=

# Secreto de integridad (test_integrity_...). SOLO SERVIDOR: firma el checkout.
WOMPI_INTEGRITY_SECRET=

# URL de eventos que se configura en el panel de Wompi (una por ambiente):
#   https://<tu-dominio>/api/webhooks/wompi
# Conciliación: guarda en Supabase Vault "payments_reconcile_url" con
#   https://<tu-dominio>/api/workers/reconcile-payments
# --- Factus: facturación electrónica (D-043) -------------------------------
# Credenciales del panel de Factus > API. Sandbox y producción son cuentas
# distintas; nunca mezcles sus credenciales.

# "sandbox" (https://api-sandbox.factus.com.co) o "production"
# (https://api.factus.com.co).
FACTUS_ENV=

# Client ID y Client Secret de la aplicación en Factus. SOLO SERVIDOR.
FACTUS_CLIENT_ID=
FACTUS_CLIENT_SECRET=

# Usuario (correo) y contraseña de la cuenta de Factus. SOLO SERVIDOR.
FACTUS_USERNAME=
FACTUS_PASSWORD=

# Id del rango de numeración de facturas de venta. Solo es obligatorio si la
# cuenta tiene más de un rango activo (en Factus: Rangos de numeración).
FACTUS_NUMBERING_RANGE_ID=
