# Variables de entorno del proyecto. Este archivo NO lleva valores reales.
#
# Cómo usarlo:
#   1. Copia este archivo como .env.local (está en .gitignore; nunca se sube).
#   2. Llena los valores del entorno que vas a usar (ver abajo).
#   3. Nunca pongas valores reales en este archivo ni en el código.
#
# Entornos:
#   - Local: con Docker corriendo, ejecuta `npm run db:start` y luego
#     `npm run db:status`. Ahí aparecen la URL de la API, la clave
#     "Publishable" y la clave "Secret" del entorno local.
#   - Pruebas (staging): proyecto propio en Supabase. Los valores están en
#     el panel de Supabase, Project Settings > API Keys.
#   - Producción: solo se configura en el proveedor de hosting, nunca aquí
#     (ver la skill pre-deploy-checklist).

# --- Supabase -------------------------------------------------------------

# URL de la API de Supabase. Local: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Clave publicable (empieza por sb_publishable_). Llega al navegador; está
# protegida por RLS. La app se niega a arrancar si aquí hay una clave secreta.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave secreta (empieza por sb_secret_). SOLO SERVIDOR: se salta RLS.
# Nunca le pongas el prefijo NEXT_PUBLIC_. La usan workers y webhooks.
SUPABASE_SECRET_KEY=

# --- Wompi (se agrega en el paso 12) ---------------------------------------
# --- Factus (se agrega en el paso 13) --------------------------------------
